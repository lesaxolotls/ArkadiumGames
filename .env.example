# ARKADIUM 3D - modèle de configuration
# Copie ce fichier en .env et adapte les valeurs.
# Les variables définies directement par l'hébergeur restent prioritaires.

# Serveur web
HOST=0.0.0.0
# Laisse PORT défini par l'hébergeur si celui-ci en fournit un.
PORT=8080
MAX_PLAYERS=50

# Base de données : remplace ce chemin par le point de montage persistant
# de ton hébergeur. Exemple si un volume est monté sur /data :
ARKADIUM_DB=/data/arkadium.sqlite3
DATABASE_URL=

# Le compte portant ce pseudo reçoit le rôle administrateur.
ADMIN_USERNAME=Lesaxolotls

# Durée de validité des sessions : 30 jours en secondes.
SESSION_DURATION=2592000

# Nom du jeu retourné par /health
WORLD_NAME=ARKADIUM 3D
